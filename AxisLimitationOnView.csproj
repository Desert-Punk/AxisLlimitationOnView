<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net48</TargetFramework>
		<OutputType>Library</OutputType>

		<!-- 1. ДОБАВЛЕНО ДЛЯ WPF -->
		<UseWPF>true</UseWPF>
	</PropertyGroup>

	<ItemGroup>
	  <Compile Remove="App.cs" />
	</ItemGroup>

	<!-- 2. УДАЛЕНЫ БЛОКИ С REVIT2022_OR_LATER (так как у нас Revit 2019) -->

	<ItemGroup>
		<!-- 3. ИСПРАВЛЕНЫ ПУТИ К REVIT API -->
		<Reference Include="RevitAPI">
			<HintPath>$(ProgramFiles)\Autodesk\Revit 2019\RevitAPI.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="RevitAPIUI">
			<HintPath>$(ProgramFiles)\Autodesk\Revit 2019\RevitAPIUI.dll</HintPath>
			<Private>False</Private>
		</Reference>
	</ItemGroup>

</Project>