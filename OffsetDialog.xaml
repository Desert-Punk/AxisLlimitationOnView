<Window x:Class="AxisLimitationOnView.OffsetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Обрезка осей по CropBox"
        Width="340" Height="230"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 0: Заголовок -->
            <RowDefinition Height="Auto"/>
            <!-- 1: Поле ввода -->
            <RowDefinition Height="Auto"/>
            <!-- 2: Текст подсказки (теперь Auto!) -->
            <RowDefinition Height="*"/>
            <!-- 3: Невидимая распорка -->
            <RowDefinition Height="Auto"/>
            <!-- 4: Кнопки -->
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Введите отступ от границы обрезки (мм):" 
                   Margin="0,0,0,8" FontWeight="SemiBold"/>

        <TextBox x:Name="OffsetTextBox" Grid.Row="1" 
                 Text="200" Height="24" VerticalContentAlignment="Center"/>

        <!-- Изменен цвет на более темный и увеличен шрифт -->
        <TextBlock Grid.Row="2" Text="Значение будет применено ко всем видимым осям на текущем виде." 
                   Foreground="#666666" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0"/>

        <!-- Кнопки переехали в строку 4, так как строка 3 теперь распорка -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Обрезать" Width="100" Height="28" Margin="0,0,8,0" 
                    IsDefault="True" Click="TrimButton_Click"/>
            <Button Content="Отмена" Width="100" Height="28" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>